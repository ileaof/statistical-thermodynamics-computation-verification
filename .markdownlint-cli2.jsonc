// markdownlint-cli2 tool config (complements .markdownlint.jsonc, which holds
// the rule settings). The handoff.md files are internal "resume here" developer
// snapshots regenerated by tooling between sessions, not published docs, so they
// are excluded from Markdown linting to avoid churn.
{
  "ignores": [
    "**/handoff.md"
  ]
}
