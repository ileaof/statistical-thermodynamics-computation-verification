// markdownlint configuration for the repository.
// Prose is written for humans, so a few default rules are relaxed:
{
  "default": true,
  "MD013": false,                   // line length: prose wraps naturally
  "MD033": false,                   // inline HTML: <sub>/<sup> for equations
  "MD040": false,                   // language on fenced code (directory trees)
  "MD041": false,                   // first line need not be a heading (badges)
  "MD024": { "siblings_only": true } // allow repeated headings in sibling sections
}
