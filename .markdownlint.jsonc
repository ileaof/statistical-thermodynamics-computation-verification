// markdownlint configuration for the repository.
// Prose is written for humans, so a few default (and some newer, pedantic)
// rules are relaxed:
{
  "default": true,
  "MD013": false,                    // line length: prose wraps naturally
  "MD033": false,                    // inline HTML: <sub>/<sup>/<div> for layout
  "MD040": false,                    // language on fenced code (directory trees)
  "MD041": false,                    // first line need not be a heading (badges)
  "MD036": false,                    // bold labels before code blocks / templates
  "MD026": false,                    // FAQ headings intentionally end with "?"
  "MD001": false,                    // decorative subtitle / FAQ heading levels
  "MD060": false,                    // table column style: GitHub renders fine
  "MD024": { "siblings_only": true } // allow repeated headings in sibling sections
}
